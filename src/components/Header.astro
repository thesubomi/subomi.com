---
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const onHome = Astro.url.pathname.replace(/\/?$/, "/") === home;
const base = onHome ? "" : home;
const sections = [
  ["Music", "music"],
  ["Writing", "writing"],
  ["Art", "art"],
  ["Travels", "travels"],
  ["Running", "running"],
];
---
<header class="site-header wrap">
  <a href={home}>©Ọláṣùbòmí</a>
  <nav class="site-nav" aria-label="Sections">
    {sections.map(([label, id]) => <a href={`${base}#${id}`}>{label}</a>)}
  </nav>
  <a href={`${base}#contact`}>Say hello</a>
</header>
