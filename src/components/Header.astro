---
import { home, url } from "../lib/site";
const path = Astro.url.pathname.replace(/\/?$/, "/");
const sections = [
  ["Music", "music/"],
  ["Writing", "writing/"],
  ["Art", "art/"],
  ["Travels", "travels/"],
  ["Running", "running/"],
];
const current = (p: string) => path.startsWith(url(p));
---
<header class="site-header wrap">
  <a class="site-name" href={home}>©Ọláṣùbòmí</a>
  <nav class="site-nav" aria-label="Sections">
    {sections.map(([label, p]) => <a href={url(p)} aria-current={current(p) ? "page" : undefined}>{label}</a>)}
  </nav>
  <a class="site-about" href={url("about/")} aria-current={current("about/") ? "page" : undefined}>About</a>
</header>
