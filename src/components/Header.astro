---
// Desktop: three links either side of the OLA mark. Mobile: the mark and a menu button.
import { home, url } from "../lib/site";
import OlaMark from "./OlaMark.astro";
import site from "../data/site.json";
const path = Astro.url.pathname.replace(/\/?$/, "/");
const left = [
  ["Music", "music/"],
  ["Running", "running/"],
  ["Writing", "writing/"],
];
const right = [
  ["About", "about/"],
  ["Reads", "reads/"],
  ["Travels", "travels/"],
];
const all = [...left, ...right.filter(([l]) => l !== "About"), ["About", "about/"]];
const current = (p: string) => path.startsWith(url(p));
---
<header class="site-header wrap">
  <nav class="site-nav site-nav-left" aria-label="Sections">
    {left.map(([label, p]) => <a href={url(p)} aria-current={current(p) ? "page" : undefined}>{label}</a>)}
  </nav>
  <a class="site-mark" href={home} aria-label={`${site.name}, home`}><OlaMark height={22} /></a>
  <nav class="site-nav site-nav-right" aria-label="More sections">
    {right.map(([label, p]) => <a href={url(p)} aria-current={current(p) ? "page" : undefined}>{label}</a>)}
  </nav>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
    <span></span><span></span>
  </button>
  <div class="site-menu" id="site-menu" hidden>
    <nav aria-label="Menu">
      {all.map(([label, p]) => <a href={url(p)} aria-current={current(p) ? "page" : undefined}>{label}</a>)}
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.getElementById("site-menu");
  if (button && menu) {
    const set = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Menu");
      menu.hidden = !open;
      document.documentElement.classList.toggle("menu-open", open);
    };
    button.addEventListener("click", () => set(button.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !menu.hidden) { set(false); button.focus(); } });
    window.matchMedia("(min-width: 761px)").addEventListener("change", (e) => { if (e.matches) set(false); });
  }
</script>
