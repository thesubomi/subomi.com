---
// The full home page. Rendered at / when maintenance is off, and at /preview/ always.
import site from "../data/site.json";
import { getWriting, getMusic, getFeatured, getArt, getTravels } from "../lib/content";
import { url, pad, monthYear, readTime } from "../lib/site";
import SectionHead from "./SectionHead.astro";
import TrackList from "./TrackList.astro";
import PlaylistLinks from "./PlaylistLinks.astro";
import RunStats from "./RunStats.astro";
import Tile from "./Tile.astro";
import MyMusic from "./MyMusic.astro";
import { playlist } from "../lib/music";
import { getImage } from "astro:assets";
import cutoutSrc from "../assets/hero-cutout.png";
import portraitSrc from "../assets/hero-portrait.jpg";

// Desktop shows the cut-out, where the head rises out of the frame over the name; phones show the portrait.
const cutout = await getImage({ src: cutoutSrc, widths: [1000, 1500, 2000], format: "webp" });
const portrait = await getImage({ src: portraitSrc, widths: [480, 800, 1200], format: "webp" });

const featured = await getFeatured();
const f = featured && playlist(featured);
const playlists = (await getMusic()).filter((p) => p.id !== featured?.id).slice(0, 4);
const [latest, ...earlier] = (await getWriting()).slice(0, 4);
const art = (await getArt())[0];
const trip = (await getTravels())[0];
---
<section class="hero" aria-label="Introduction">
  <h1>{site.name}</h1>
  <picture class="hero-photo">
    <source media="(min-width: 761px)" srcset={cutout.srcSet.attribute} sizes="min(66vw, 980px)" width={cutoutSrc.width} height={cutoutSrc.height} />
    <img src={portrait.src} srcset={portrait.srcSet.attribute} sizes="72vw" width={portraitSrc.width} height={portraitSrc.height} alt="Ọláṣùbòmí in a headband, headphones and red running glasses, one hand at his face." fetchpriority="high" decoding="async" />
  </picture>
  <p>{site.intro.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
</section>

<section class="row now" id="now" aria-label="Now">
  <span>[ Now ]</span>
  <ol>
    {site.now.map((line, i) => <li><span class="n">{pad(i + 1)}</span><span set:html={line} /></li>)}
  </ol>
  <div class="aside"><a href={url("about/")}>→ More about me</a></div>
</section>

<section class="section" aria-labelledby="music-h">
  <SectionHead title="Music" id="music-h" link={{ href: url("music/"), label: "All music" }} />
  <MyMusic />
  {featured && f && (
    <div class="row featured">
      <span class="label">[ On repeat ]</span>
      <div>
        <a class="featured-title" href={url(`music/${featured.id}/`)}>{featured.data.title}</a>
        <span class="featured-note">{featured.data.note}</span>
        <TrackList tracks={f.tracks} limit={5} />
        <a class="label more-tracks" href={url(`music/${featured.id}/`)}>→ All {f.count} tracks</a>
      </div>
      <PlaylistLinks spotify={featured.data.spotify} appleMusic={featured.data.appleMusic} meta={f.meta} />
    </div>
  )}
  <ul class="index playlists">
    {playlists.map((p, i) => (
      <li>
        <a href={url(`music/${p.id}/`)}>
          <span class="n">{pad(i + 2)}</span>
          <span class="title">{p.data.title}</span>
          <span class="muted hide-s">{p.data.note}</span>
          <span class="meta hide-s">{playlist(p).count ? `${playlist(p).count} tracks` : ""}</span>
          <span class="go">→ Listen</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section class="section" aria-labelledby="writing-h">
  <SectionHead title="Writing" id="writing-h" link={{ href: url("writing/"), label: "All writing" }} />
  {latest && (
    <a class="row latest" href={url(`writing/${latest.id}/`)}>
      <span class="label">[ Latest ]</span>
      <span>
        <span class="latest-title">{latest.data.title}</span>
        {latest.data.description && <span class="latest-excerpt">{latest.data.description}</span>}
      </span>
      <span class="aside"><span>{monthYear(latest.data.date)}</span><span class="muted">{readTime(latest.body)}</span><span class="u">Read</span></span>
    </a>
  )}
  <ul class="index posts">
    {earlier.map((w, i) => (
      <li>
        <a href={url(`writing/${w.id}/`)}>
          <span class="n">{pad(i + 2)}</span>
          <span class="meta hide-s">{monthYear(w.data.date)}</span>
          <span class="title">{w.data.title}</span>
          <span class="go hide-s">→ Read</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<section class="row section" aria-label="Art and travels">
  <span class="label">[ Art &amp; travels ]</span>
  {!art && !trip ? <p class="soon-text">Coming soon. The first pieces and trips are on their way.</p> : <div class="gallery">
    {art && <Tile href={url(`art/${art.id}/`)} title={art.data.title} kind="Art" n="01" image={art.data.image} alt={art.data.alt} placeholder="Latest piece" />}
    {trip && <Tile href={url(`travels/${trip.id}/`)} title={trip.data.place} kind="Travels" n="02" image={trip.data.cover} alt={trip.data.alt} placeholder="Photo from the trip" />}
  </div>}
  <div class="aside"><a href={url("art/")}>→ All art</a><a href={url("travels/")}>→ All travels</a></div>
</section>

<section class="section" aria-labelledby="running-h">
  <SectionHead title="Running" id="running-h" link={{ href: url("running/"), label: "More running" }} />
  <RunStats />
</section>
