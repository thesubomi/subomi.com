---
// This month's running totals and a single ink line for weekly distance (src/data/running.json, filled from Strava).
import running from "../data/running.json";

const kms = running.weeks.map((w) => w.km);
const top = Math.max(10, Math.ceil(Math.max(...kms) / 10) * 10);
const spark = kms
  .map((km, i) => `${((i * 240) / Math.max(1, kms.length - 1)).toFixed(1)},${(46 - (km / top) * 44).toFixed(1)}`)
  .join(" ");
const first = running.weeks[0];
const last = running.weeks[running.weeks.length - 1];
---
<div class="row">
  <span class="label">[ {running.month} ]{running.example && <><br /><span class="muted">example numbers</span></>}<br /><span class="muted">Updated {running.updated}</span></span>
  <div class="span-2">
    <dl class="stats">
      {running.stats.map((s) => (
        <div class="stat">
          <dt>{s.label}</dt>
          <dd>{s.value}{s.unit && <span>{s.unit}</span>}</dd>
        </div>
      ))}
    </dl>
    <figure class="spark">
      <svg viewBox="0 0 240 48" preserveAspectRatio="none" role="img" aria-label={`Kilometres per week over the last ${kms.length} weeks, from ${first.km} to ${last.km}`}>
        <polyline points={spark} fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
      </svg>
      <figcaption><span>{first.label}</span><span>Kilometres per week, from Strava</span><span>{last.label}</span></figcaption>
    </figure>
  </div>
</div>
