---
// A picture tile for art and travels. Without an image it shows a labelled grey placeholder.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { href: string; title: string; kind: string; n: string; image?: ImageMetadata; alt?: string; placeholder: string; eager?: boolean }
const { href, title, kind, n, image, alt = "", placeholder, eager = false } = Astro.props;
---
<a class="tile" href={href}>
  <span class="tile-image">
    {image
      ? <Image src={image} alt={alt} widths={[400, 800, 1200]} sizes="(max-width: 760px) 100vw, 33vw" loading={eager ? "eager" : "lazy"} />
      : <span>[ {placeholder} ]</span>}
  </span>
  <span class="tile-caption"><span><span class="n">{n}</span>{title}</span><span class="label muted">{kind}</span></span>
</a>
