---
import { pad } from "../lib/site";
import type { Track } from "../lib/music";
interface Props { tracks: Track[]; limit?: number }
const { tracks, limit } = Astro.props;
const shown = limit ? tracks.slice(0, limit) : tracks;
---
{shown.length > 0 && (
  <ol class="tracks">
    {shown.map((t, i) => (
      <li class="track">
        <span class="track-num">{pad(i + 1)}</span>
        <span><span class="track-title">{t.title}</span><span class="track-artist">{t.artist}</span></span>
        <span class="track-note">{t.note ?? ""}</span>
        <span class="track-time">{t.duration ?? ""}</span>
      </li>
    ))}
  </ol>
)}
