---
import "../styles/site.css";
import site from "../data/site.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/site";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { title?: string; description?: string; noindex?: boolean; type?: "website" | "article"; image?: ImageMetadata; imageAlt?: string }
const { title, description = site.description, type = "website" } = Astro.props;
// While the maintenance page is up, nothing behind it is offered to search engines.
const noindex = Astro.props.noindex || site.maintenance;
const pageTitle = title ? `${title} · ${site.name}` : site.shareTitle;
// A page can bring its own share image (a post's featured image); otherwise the site-wide one is used.
const shared = Astro.props.image ? await getImage({ src: Astro.props.image, format: "jpg" }) : null;
const image = shared ? new URL(shared.src, Astro.site) : new URL(url(site.shareImage.src), Astro.site);
const imageWidth = shared ? Astro.props.image!.width : 1200;
const imageHeight = shared ? Astro.props.image!.height : 630;
const imageAlt = shared ? Astro.props.imageAlt || title || site.shareImage.alt : site.shareImage.alt;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url("favicon.ico")} sizes="any" />
    <link rel="icon" href={url("favicon.png")} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href={url("rss.xml")} />
    <meta name="theme-color" content="#fbfbfb" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="subomi.com" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
