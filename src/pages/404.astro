---
import Base from "../layouts/Base.astro";
const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Base title="Not found">
  <section class="lost">
    <span class="label">[ 404 ]</span>
    <h1>This page isn't here.</h1>
    <a class="u" href={home}>Back to the home page</a>
  </section>
</Base>
