---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import { getArt } from "../../lib/content";
import { url, monthYear } from "../../lib/site";

export async function getStaticPaths() {
  const all = await getArt();
  return all.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
const d = piece.data;
---
<Base title={d.title} description={d.medium ? `${d.title}. ${d.medium}.` : d.title}>
  <article>
    <header class="article-head">
      <a class="label" href={url("art/")}>← Art</a>
      <h1>{d.title}</h1>
    </header>
    <figure class="piece">
      {d.image
        ? <Image src={d.image} alt={d.alt} widths={[640, 1200, 1800]} sizes="(max-width: 760px) 100vw, 900px" loading="eager" />
        : <span class="tile-image piece-placeholder">[ Image of the piece ]</span>}
    </figure>
    <div class="row article-body">
      <div class="label article-meta"><span>{monthYear(d.date)}</span>{d.medium && <span class="muted">{d.medium}</span>}</div>
      <div class="prose"><Content /></div>
      <span></span>
    </div>
  </article>
</Base>
