---
// Home. While "maintenance" is true in src/data/site.json, visitors see the Building in progress page.
// Set it to false to put the full site live.
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import Maintenance from "../components/Maintenance.astro";
import site from "../data/site.json";
---
{site.maintenance ? (
  <Maintenance />
) : (
  <Base>
    <Home />
  </Base>
)}
