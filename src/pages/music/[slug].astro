---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import TrackList from "../../components/TrackList.astro";
import PlaylistLinks from "../../components/PlaylistLinks.astro";
import Player from "../../components/Player.astro";
import { getMusic } from "../../lib/content";
import { playlist } from "../../lib/music";
import { url } from "../../lib/site";

export async function getStaticPaths() {
  const all = await getMusic();
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const p = playlist(entry);
---
<Base title={d.title} description={d.note}>
  <article>
    <header class="article-head">
      <a class="label" href={url("music/")}>← Music</a>
      <h1>{d.title}</h1>
      <p class="article-lede">{d.note}</p>
    </header>

    <div class="row playlist-body">
      <div class="article-meta">
        {p.cover && <img class="playlist-cover" src={p.cover} alt={`Cover of ${d.title}`} width="300" height="300" loading="eager" />}
        {p.meta && <span class="label muted">{p.meta}</span>}
      </div>
      <div>
        {entry.body?.trim() && <div class="prose playlist-note"><Content /></div>}
        <Player link={d.spotify} title={d.title} />
        <TrackList tracks={p.tracks} />
      </div>
      <PlaylistLinks spotify={d.spotify} appleMusic={d.appleMusic} />
    </div>
  </article>

  {next && next.id !== entry.id && (
    <nav class="row pager" aria-label="More music">
      <span class="label">[ Next ]</span>
      <div class="pager-links">
        <a href={url(`music/${next.id}/`)}><span class="label muted">Next playlist →</span><span class="pager-title">{next.data.title}</span></a>
      </div>
      <div class="aside"><a href={url("music/")}>→ All music</a></div>
    </nav>
  )}
</Base>
