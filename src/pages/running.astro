---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import RunStats from "../components/RunStats.astro";
import running from "../data/running.json";
import { isReal, pad } from "../lib/site";
import { Image } from "astro:assets";
import photo1 from "../assets/running/01.jpg";
import photo2 from "../assets/running/02.jpg";
import photo4 from "../assets/running/04.jpg";

const photos = [
  { src: photo2, alt: "Ọláṣùbòmí mid-race at the Warszawska Dycha, bib 33018, the crowd blurred behind him in the sun." },
  { src: photo1, alt: "Ọláṣùbòmí running the Warszawska Dycha in black Nike kit, headband and red-lensed glasses, with other runners behind him." },
  { src: photo4, alt: "A finisher medal engraved Olasubomi Archibong, 00:51:20, held up against the sun in Warsaw." },
];
---
<Base title="Running" description="Ọláṣùbòmí Archibong's running, synced from Strava.">
  <section class="page-intro">
    <SectionHead title="Running" level={1} link={isReal(running.profile) ? { href: running.profile, label: "Follow on Strava" } : undefined} />
    <p class="page-lede">Every run syncs from Strava. The numbers update on their own each morning.</p>
  </section>

  <figure class="run-gallery-wrap section-tight">
    <div class="run-gallery" role="group" aria-label="Photos from runs">
      {photos.map((p, i) => (
        <Image src={p.src} alt={p.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 80vw, 33vw" loading={i === 0 ? "eager" : "lazy"} />
      ))}
    </div>
    <figcaption class="run-caption">
      <span>[ September 2026 ]</span>
      <span>Nice to Fit You (10 km)</span>
      <span>51:20</span>
    </figcaption>
  </figure>

  <section class="section-tight">
    <RunStats />
  </section>

  {running.year && (
    <section class="row section-tight" aria-label={`Running in ${running.year.label}`}>
      <span class="label">[ {running.year.label} so far ]</span>
      <dl class="stats span-2">
        {running.year.stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.value}{s.unit && <span>{s.unit}</span>}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {running.recent?.length > 0 && (
    <section class="row section" aria-label="Recent runs">
      <span class="label">[ Recent runs ]</span>
      <ol class="tracks runs">
        {running.recent.map((r, i) => (
          <li class="track run">
            <span class="track-num">{pad(i + 1)}</span>
            <span><span class="track-title">{r.name}</span><span class="track-artist">{r.date}</span></span>
            <span class="run-figures"><span>{r.distance} km</span><span class="muted">{r.time}</span><span class="muted">{r.pace} /km</span></span>
          </li>
        ))}
      </ol>
      <span></span>
    </section>
  )}
</Base>
