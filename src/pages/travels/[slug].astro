---
import Base from "../../layouts/Base.astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import { getTravels } from "../../lib/content";
import { url, monthYear } from "../../lib/site";

export async function getStaticPaths() {
  const all = await getTravels();
  return all.map((trip) => ({ params: { slug: trip.id }, props: { trip } }));
}

const { trip } = Astro.props;
const { Content } = await render(trip);
const d = trip.data;
---
<Base title={d.place} description={`${d.place}, ${monthYear(d.date)}.`}>
  <article>
    <header class="article-head">
      <a class="label" href={url("travels/")}>← Travels</a>
      <h1>{d.place}</h1>
    </header>
    <figure class="piece">
      {d.cover
        ? <Image src={d.cover} alt={d.alt} widths={[640, 1200, 1800]} sizes="(max-width: 760px) 100vw, 900px" loading="eager" />
        : <span class="tile-image piece-placeholder">[ Cover photo ]</span>}
    </figure>
    <div class="row article-body">
      <div class="label article-meta"><span>{monthYear(d.date)}</span></div>
      <div class="prose"><Content /></div>
      <span></span>
    </div>
    {d.photos.length > 0 && (
      <div class="photos">
        {d.photos.map((p) => (
          <figure>
            <Image src={p.image} alt={p.alt} widths={[480, 960, 1440]} sizes="(max-width: 760px) 100vw, 50vw" />
            {p.caption && <figcaption class="label muted">{p.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </article>
</Base>
